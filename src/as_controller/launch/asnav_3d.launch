<launch>
    <arg name="open_rviz" default="false" />

    <node pkg="as_controller" type="asnav_3d_node" name="asnav_3d_node" output="screen">  
        <param name="target_class_name" type="string" value="red_ballon" /> 
        <param name="fly_height" type="double" value="0.45" /> 
        <param name="descend_z" type="double" value="1.4" /> 
        <!-- 导航轴策略全局默认：接口 nav_mode<0 时使用（0=全跟规划器 1=只Z 2=只Yaw 3=锁高并锁0） -->
        <param name="nav_default_mode" type="int" value="3" />
        <!-- zpro 控制器参数 -->
        <param name="zpro_kp"              value="1.3"  type="double"/>
        <param name="zpro_ki"              value="0.4"  type="double"/>
        <param name="zpro_max_v"           value="1.0"  type="double"/>
        <param name="zpro_integral_clamp"  value="0.5"  type="double"/>
        <param name="zpro_err_thresh"      value="0.5"  type="double"/>
        <!-- 短距离激进刹车：1.5米就开始减速 -->
        <param name="zpro_brake_dist"  value="1.0"  type="double"/>
        <param name="zpro_brake_min_v" value="0.10" type="double"/>
        <param name="zpro_accel_ff_gain"     value="0.2"  type="double"/>  <!-- 0=关, 0.5=半量, 1=全量 -->

        <!-- navigationSuper 控制器参数 -->
        <param name="super_kp_outer"     type="double" value="2.6" />   <!-- Kp: 位置误差→速度修正 -->
        <param name="super_kv_outer"     type="double" value="2.2" />   <!-- Kv: 速度误差阻尼（核心）; 2026-09-30: 0.8→0.3, 抑制仿真下速度阻尼振荡 -->
        <param name="super_ki_outer"     type="double" value="0.05" />  <!-- Ki: 位置误差积分 -->
        <param name="super_ff_gain"      type="double" value="1.0" />  <!-- 速度前馈系数XY (2026-10-05; 0.5=fuel_nav等效) -->
        <param name="super_ff_gain_z"    type="double" value="0.0" />  <!-- 速度前馈系数Z  (2026-10-05; 0=fuel_nav等效) -->
        <param name="super_max_vel"      type="double" value="2.5" />  <!-- XY 速度限幅 (m/s) -->
        <param name="super_max_vel_z"    type="double" value="1.0" />   <!-- Z  速度限幅 (m/s) -->
        <param name="super_max_integral" type="double" value="0.5" />   <!-- 积分抗饱和 -->
        <param name="super_traj_timeout" type="double" value="0.5" />   <!-- SUPER断联超时→悬停 (对齐 ruikang traj_timeout=0.5, 换点空窗不误触) -->
        <param name="super_rotate_180"   type="bool"   value="false" /> <!-- 坐标系旋转 -->
        <param name="ego_rotate_180"     type="bool"   value="false" /> <!-- ego 轨迹 180°旋转，默认 false：LIO系=PX4 local -->
        <param name="super_max_accel"    type="double" value="3.0" />

        <!-- 轮廓控制（contouring control）参数（2026-10-08 新增）
             enable=false 时 navigationSuper 完全走原各向同性控制律，行为与改动前一致。
             启用方式：① 把 enable 改 true（全局）；② 调用 navigationSuperContour / navigationSuperContourRviz 接口。
             含义：kp_t 切向（沿轨迹，放松保速度）、kp_n 法向（垂直轨迹，收紧贴路径）、
                   ff_t 切向前馈（接近 1.0 可消除稳态滞后）、min_spd 低于此值退化为各向同性。 -->
        <param name="super_contour_enable"  type="bool"   value="false" />
        <param name="super_contour_kp_t"    type="double" value="0.6" />
        <param name="super_contour_kp_n"    type="double" value="1.6" />
        <param name="super_contour_ff_t"    type="double" value="0.9" />
        <param name="super_contour_min_spd" type="double" value="0.15" />

        <!-- 第一梯队：三段式增益 -->
        <param name="ego_kp_outer"     type="double" value="2.6" />   <!-- Kp: 位置误差→速度修正 -->
        <param name="ego_kv_outer"     type="double" value="2.2" />   <!-- Kv: 速度误差阻尼（核心） -->
        <param name="ego_ki_outer"     type="double" value="0.05" />   <!-- Ki: 位置误差积分 -->
        <param name="ego_ff_gain"      type="double" value="1.0" />   <!-- 速度前馈系数XY (2026-10-05; 0.5=fuel_nav等效) -->
        <param name="ego_ff_gain_z"    type="double" value="0.0" />   <!-- 速度前馈系数Z  (2026-10-05; 0=fuel_nav等效) -->

        <!-- 限幅 -->
        <param name="ego_max_vel"      type="double" value="1.8" />   <!-- = max_vel ，给修正留空间 -->
        <param name="ego_max_vel_z"    type="double" value="1.0" />   <!-- Z 速度限幅 (2026-10-05) -->
        <param name="ego_max_integral" type="double" value="0.5" />   <!-- 积分抗饱和 -->

        <!-- 安全 -->
        <param name="ego_traj_timeout" type="double" value="0.5" />   <!-- ego断联超时→悬停（超时/轨迹完成 → 位置锁存） -->

        <!-- positionSmooth 步长控制参数（单位 m/cycle @50Hz；原 0.20/0.15 相当于 10/7.5 m/s，平滑失效导致阶跃晃动） -->
        <param name="smooth_step_xy"      type="double" value="0.04"/>  <!-- 2 m/s @50Hz：接近段推进 -->
        <param name="smooth_slow_step_xy" type="double" value="0.01"/>  <!-- 0.5 m/s @50Hz：减速区真正生效，回到代码默认值 -->
        <param name="smooth_slow_dist"    type="double" value="0.50" />  <!-- 提早 0.8m 进入减速区，避免高速冲进容差圈 -->

    </node>

    <!-- <group if="$(arg open_rviz)">
			<node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find as_controller)/rviz/asnav.rviz" />
	</group> -->

    <!-- <include file="$(find usb_cam)/launch/usb_cam-test.launch">
    </include> -->

    <!-- <include file="$(find yolov8_ros)/launch/yolo_v8.launch">
    </include> -->

    <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" output="screen">
        <param name="image_topic" value="/yolov8/detection_image" />
    </node> -->

</launch>
