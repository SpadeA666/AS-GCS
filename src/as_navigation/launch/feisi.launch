<launch>
    <arg name="fly_height" default="1.4" />
    <arg name="hover_low_height" default="0.3" />
    <arg name="mission_interval" default="4" />
    <arg name="flight_type" default="1" />
    <arg name="is_insert_waypoint" default="false" />
    <arg name="pub_delay" default="0" />
    <arg name="target_area_offset_z" default="-0.5" />
    <arg name="hover_waypoint" default="2" />   <!-- 悬停点ID (从0开始) -->
    <arg name="descend_waypoint" default="5" /> <!-- 下降点ID (从0开始) -->
    <include file="$(find navigation_2d)/launch/move_base.launch">
    </include>

    <node pkg="navigation_2d" type="feisi_node" name="feisi_node" output="screen">
        <param name="fly_height" value="$(arg fly_height)" />
        <param name="hover_low_height" value="$(arg hover_low_height)" />
        <param name="target_area_offset_z" value="$(arg target_area_offset_z)" />
        <param name="mission_interval" value="$(arg mission_interval)" />
        <param name="pub_rate" value="15" />
        <param name="flight_type" value="$(arg flight_type)" />
        <param name="pub_delay" value="$(arg pub_delay)" />
        <param name="object_width" value="0.1" />
        <param name="object_height" value="0.1" />
        <param name="confidence_threshold" value="0.85" />
        <param name="detect_times" value="30" />
        <param name="is_insert_waypoint" value="$(arg is_insert_waypoint)" />
        <param name="point_num" value="11" />

        <param name="hover_waypoint" value="$(arg hover_waypoint)" />
        <param name="descend_waypoint" value="$(arg descend_waypoint)" />

        <param name="point0_x" value="2" />
        <param name="point0_y" value="0" />

        <param name="point1_x" value="3.3" />
        <param name="point1_y" value="0" />

        <param name="point2_x" value="4.2" />
        <param name="point2_y" value="-0.6" />

        <param name="point3_x" value="3.3" />
        <param name="point3_y" value="0.7" />

        <param name="point4_x" value="2" />
        <param name="point4_y" value="2" />

        <param name="point5_x" value="4" />
        <param name="point5_y" value="2.6" />

        <param name="point6_x" value="1.4" />
        <param name="point6_y" value="2.6" />

        <param name="point7_x" value="2.6" />
        <param name="point7_y" value="1.4" />

        <param name="point8_x" value="3.2" />
        <param name="point8_y" value="0.3" />

        <param name="point9_x" value="1.5" />
        <param name="point9_y" value="-0.5" />

        <param name="point10_x" value="0" />
        <param name="point10_y" value="-0.2" />


    </node>


    <node name="rqt_image_view" pkg="rqt_image_view" type="rqt_image_view" output="screen"/>

</launch>
