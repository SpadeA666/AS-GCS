<launch>
    <arg name="open_rviz" default="false" />

    <node pkg="as_navigation" type="asnav_3d_node" name="asnav_3d_node" output="screen">  
        <param name="is_auto_land" type="bool" value="true" /> 
        <param name="target_class_name" type="string" value="red_ballon" /> 
        <param name="fly_height" type="double" value="0.5" /> 
        <param name="descend_z" type="double" value="1.4" /> 
        <!-- zpro 控制器参数 -->
        <param name="zpro_kp"              value="1.3"  type="double"/>
        <param name="zpro_ki"              value="0.4"  type="double"/>
        <param name="zpro_max_v"           value="1.0"  type="double"/>
        <param name="zpro_integral_clamp"  value="0.5"  type="double"/>
        <param name="zpro_err_thresh"      value="0.5"  type="double"/>
        <!-- 短距离激进刹车：1.5米就开始减速 -->
        <param name="zpro_brake_dist"  value="1.0"  type="double"/>
        <param name="zpro_brake_min_v" value="0.10" type="double"/>
        <param name="zpro_accel_ff_gain"     value="0.2"  type="double"/>  <!-- 0=关, 0.5=半量, 1=全量 -->



        <!-- navigationSuper 控制器参数 -->
        <param name="super_kp_outer"     type="double" value="1.8" />   <!-- Kp: 位置误差→速度修正 -->
        <param name="super_kv_outer"     type="double" value="2.2" />   <!-- Kv: 速度误差阻尼（核心） -->
        <param name="super_ki_outer"     type="double" value="0.3" />   <!-- Ki: 位置误差积分 -->
        <param name="super_max_vel"      type="double" value="1.0" />   <!-- XY 速度限幅 (m/s) -->
        <param name="super_max_vel_z"    type="double" value="1.0" />   <!-- Z  速度限幅 (m/s) -->
        <param name="super_max_integral" type="double" value="0.5" />   <!-- 积分抗饱和 -->
        <param name="super_traj_timeout" type="double" value="0.1" />   <!-- SUPER断联超时→悬停 -->
        <param name="super_rotate_180"   type="bool"   value="false" /> <!-- 坐标系旋转 -->
        <param name="ego_rotate_180"     type="bool"   value="false" /> <!-- ego 轨迹 180°旋转，默认 false：LIO系=PX4 local -->
        <param name="super_max_accel"    type="double" value="2.5" />   <!-- 速度指令帧间加速度限幅 (m/s^2)，0=关闭：消除换航点/新轨迹切入时的速度阶跃 -->

        <!-- 姿态推力控制接口参数（navigationSuperAtt / navigationSuperFF / navigationZplusAtt，px4ctrl 风格） -->
        <param name="att_kp"               type="double" value="1.0" />  <!-- 级联位置环 P（px4ctrl gain.Kp*） -->
        <param name="att_kv"               type="double" value="0.8" />  <!-- 级联速度环 P（px4ctrl gain.Kv*） -->
        <param name="att_hover_percentage" type="double" value="0.5" />  <!-- 悬停油门比例：thr2acc = g/hover%，实机务必按 Stabilize 悬停值标定 -->
        <param name="att_max_angle"        type="double" value="40.0" /> <!-- 倾角限制 (deg) -->
        <param name="att_kang_r"           type="double" value="20.0" /> <!-- 姿态误差→反馈角速度增益（px4ctrl KAng） -->
        <param name="att_kang_p"           type="double" value="20.0" />
        <param name="att_kang_y"           type="double" value="4.0" />
        <param name="att_use_planner_yaw"  type="bool"   value="true" /> <!-- yaw=NAN 时跟随规划器 yaw 前馈（false=保持当前 yaw） -->

        <!-- 第一梯队：三段式增益 -->
        <param name="zplus_kp_outer"     type="double" value="1.6" />
        <param name="zplus_kv_outer"     type="double" value="1.4" />
        <param name="zplus_ki_outer"     type="double" value="0.3" />

        <param name="zplus_max_vel"      type="double" value="1.0" />
        <param name="zplus_max_integral" type="double" value="0.5" />

        <param name="zplus_traj_timeout" type="double" value="0.5" />
        <param name="zplus_max_accel"    type="double" value="2.5" />   <!-- 速度指令帧间加速度限幅 (m/s^2)，0=关闭 -->

        <!-- positionSmooth 步长控制参数 -->
        <param name="smooth_step_xy"      type="double" value="0.18"/>  <!-- 正常步长 (m/cycle) -->
        <param name="smooth_slow_step_xy" type="double" value="0.01"/>  <!-- 接近目标减速步长 (m/cycle) -->
        <param name="smooth_slow_dist"    type="double" value="0.5" />  <!-- 减速触发距离阈值 (m) -->

    </node>

    <!-- <group if="$(arg open_rviz)">
			<node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find as_navigation)/rviz/asnav.rviz" />
	</group> -->

    <!-- <include file="$(find usb_cam)/launch/usb_cam-test.launch">
    </include> -->

    <!-- <include file="$(find yolov8_ros)/launch/yolo_v8.launch">
    </include> -->

    <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" output="screen">
        <param name="image_topic" value="/yolov8/detection_image" />
    </node> -->

</launch>
